# Roadmap task files carry YAML front matter but are markdown, not standalone
# YAML documents; yamllint parses the whole file as YAML and errors on the prose
# body. Skip the yaml check for them (rumdl still lints the markdown).
roadmap/*/*.md skipchecks=yaml:::yamllint;;;markdown[[space]]front[[space]]matter[[space]]not[[space]]standalone[[space]]YAML

# The bundled UI fonts (Inter, DejaVu, Noto Color Emoji) are binary assets
# (embedded into the viewer via include_bytes!); treat them as binary so git does
# not attempt text diffs or line-ending normalisation on them.
sl-viewer-ui-core/assets/fonts/*.ttf binary

# The bundled fonts' licence texts are redistributed **verbatim** — that is the
# condition under which we may ship the fonts at all. They are upstream files, not
# ours to reformat, so their trailing whitespace (the DejaVu one has some) is not
# a defect to fix. Unset git's own `whitespace` attribute rather than modify them:
# the pre-commit whitespace check is `git diff-index --check`, which runs over all
# staged files at once — a per-file `skipchecks=` never reaches it, but this does.
sl-viewer-ui-core/assets/fonts/*LICENSE*.txt -whitespace
sl-viewer-ui-core/assets/fonts/OFL.txt -whitespace

# The LSL differential-testing corpus is deliberately invalid in places (the
# error/ scripts each trigger a specific compile error): they are oracle input,
# fed to tailslide and sl-lsl to be diffed, not code meant to pass a linter.
# Their validity is judged by the differential oracle, so skip the pre-commit
# LSL linter for the whole corpus tree.
sl-lsl/tests/corpus/**/*.lsl skipchecks=lsl:::lslint;;;deliberately[[space]]invalid[[space]]differential-oracle[[space]]fixtures

# The cargo-about license template is a whitespace-significant plain-text
# template (its output format is machine-parsed by the About floater), not an
# HTML/glimmer document: prettier's glimmer formatter reflows and breaks the
# marker-line format, and precompilation does not apply.
scripts/third-party-licenses.hbs skipchecks=handlebars;;;whitespace-significant[[space]]plain-text[[space]]template

# Verbatim third-party license texts keep their original trailing whitespace;
# exempt the generated file from git's whitespace checking (diff-index --check,
# the common:::whitespace hook) via the native whitespace attribute.
sl-client-bevy-viewer/assets/licenses/third-party-licenses.txt -whitespace

# The vendored Linden Lab character assets (see viewer-assets/README.md):
# binary meshes and textures, plus upstream XML kept verbatim — so the
# repo-wide text checks do not police upstream content.
viewer-assets/character/*.llm binary
viewer-assets/character/*.tga binary
# Verbatim upstream files keep their whitespace exactly as shipped: disable
# git's own whitespace checking (`git diff-index --check`, which the
# pre-commit whitespace check runs) for them via the native attribute.
viewer-assets/character/* -whitespace
viewer-assets/LGPL-license.txt -whitespace
# The upstream XML is not reformatted either (`xml` silences the whole
# xmllint check group for it). The repo-wide typos and whitespace checks are
# handled by _typos.toml and the `-whitespace` attribute above — per-file
# skipchecks cannot reach repo-wide checks.
viewer-assets/character/*.xml skipchecks=xml;;;vendored[[space]]upstream[[space]]content

# The vendored static assets — the fixed-UUID built-in animations, library
# body parts, clothing and gestures a grid would otherwise serve. Every one is
# treated as binary: the keyframe motions are, and the wearable and gesture
# "text" formats carry trailing NULs and upstream line endings that no text
# check should touch or normalise.
viewer-assets/static_assets/* binary
viewer-assets/fs_static_assets/* binary
viewer-assets/static_assets/* -whitespace
viewer-assets/fs_static_assets/* -whitespace
